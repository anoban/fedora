{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: g++ build active file",
      "command": "/usr/bin/g++",
      "args": [
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.out",
        "-I./",
        "-I./include/",
        "-DDEBUG",
        "-D_DEBUG",
        "-O0",
        "-g3",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-std=c++20",
        "-march=tigerlake",
        "-mavx512f",
        "-mprefer-vector-width=512",
        "-fdiagnostics-color=always"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Task generated by Debugger."
    }
  ],
  "version": "2.0.0"
}
